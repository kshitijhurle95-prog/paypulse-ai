# xAI Grok API Configuration
# Get your API key at https://console.x.ai/
XAI_API_KEY=your_xai_grok_api_key_here
GROK_MODEL=grok-4.7

# PayPal Sandbox Developer Credentials
# Get your Sandbox App credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=SANDBOX

# Optional Sponsor Webhook (Zapier)
# Triggered when overdue recovery reminders or high-value invoices are sent
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy/
